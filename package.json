{
  "name": "chatbot-ia-redes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --import ./test/ayudas/md.js --test \"test/**/*.test.js\"",
    "simular": "node test/simulador/chat.mjs",
    "prompt": "node --import ./test/ayudas/md.js scripts/ver-prompt.mjs",
    "db:local": "wrangler d1 migrations apply chatbot --local",
    "db:nube": "wrangler d1 migrations apply chatbot --remote",
    "webhook": "node scripts/webhook.mjs",
    "deploy": "npm test && npm run db:nube && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
